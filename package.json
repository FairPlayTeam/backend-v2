{
  "name": "fp-backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.10",
  "license": "AGPL-3.0-only",
  "description": "FairPlay backend API built with TypeScript, Express, Prisma, and Bun.",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun --watch scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "start": "bun dist/index.js",
    "openapi:snapshot": "bun scripts/write-openapi-snapshot.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun run test:unit",
    "test:unit": "bun scripts/run-with-sharp-concurrency.ts bun test",
    "test:integration": "bun scripts/run-with-sharp-concurrency.ts vitest run --config tests/vitest.config.ts",
    "check": "bun scripts/check.ts",
    "check:static": "bun run typecheck && bun run lint && bun run format:check && bun run prisma:format:check && bunx prisma validate",
    "check:tests": "bun run test:unit && bun run test:integration",
    "check:security": "bun audit",
    "check:build": "bun run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:format": "bunx prisma format",
    "prisma:format:check": "bunx prisma format --check",
    "prisma:generate": "bunx prisma generate",
    "prisma:migrate": "bun run prisma:migrate:dev",
    "prisma:migrate:dev": "bunx prisma migrate dev",
    "prisma:migrate:deploy": "bunx prisma migrate deploy",
    "prisma:migrate:status": "bunx prisma migrate status",
    "prisma:studio": "bunx prisma studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/s3-request-presigner": "^3.1176.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.1.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.2",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "effect": "3.22.5",
    "glob": "14.0.6"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100
  }
}
